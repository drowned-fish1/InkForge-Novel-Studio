    },
    {
      "id": "scene-2",
      "text": "InkForge，本地优先的 AI 小说创作驾驶舱。",
      "src": "voiceover/manbo/seg-02.mp3",
      "durationSeconds": 3.744,
      "sceneDurationInFrames": 142,
