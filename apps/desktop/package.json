{
  "name": "@inkforge/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5273 --strictPort",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "desktop": "concurrently -k \"npm:dev\" \"wait-on http://127.0.0.1:5273 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5273 electron .\""
  },
  "dependencies": {
    "@inkforge/ai-provider": "0.1.0",
    "@inkforge/agent-engine": "0.1.0",
    "@inkforge/prompt-engine": "0.1.0",
    "@inkforge/schemas": "0.1.0",
    "@vitejs/plugin-react": "^5.1.1",
    "docx": "^9.6.1",
    "electron": "^39.2.7",
    "fs-extra": "^11.3.5",
    "lucide-react": "^0.555.0",
    "marked": "^18.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "scheduler": "^0.27.0",
    "yauzl": "^2.10.0",
    "zod": "^4.1.13",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  }
}
